# ---------------------------------------------------------------- Docker Compose
# Passwort der PostgreSQL-Datenbank. Nur Buchstaben und Ziffern (steht in einer URL),
# z. B. erzeugen mit:  openssl rand -hex 24
POSTGRES_PASSWORD=bitte-aendern
# Port, an den nginx weiterleitet
FP_PORT=8000
# Adresse, auf der der Port veröffentlicht wird. Vorgabe 127.0.0.1: nur für nginx auf
# demselben Host. Sitzt der Proxy auf einem anderen Rechner (z. B. über VPN), hier die
# Adresse dieses Hosts eintragen, z. B. FP_BIND=192.168.178.103
FP_BIND=127.0.0.1
# Wessen X-Forwarded-For geglaubt wird. Nur bei FP_BIND=127.0.0.1 darf hier „*" stehen.
# Sonst die Adresse des Proxys, wie die App sie sieht – mehrere mit Komma, CIDR erlaubt.
FP_PROXY_IPS=*

# ---------------------------------------------------------------- Anwendung
# Verbindung zur PostgreSQL-Datenbank (SQLAlchemy-URL mit psycopg-Treiber).
# Unter Docker Compose wird dieser Wert automatisch überschrieben.
FP_DATABASE_URL=postgresql+psycopg://fahrrad:fahrrad@localhost:55432/fahrrad
# Nur für die Tests: eigene Datenbank, wird bei jedem Testlauf neu angelegt
FP_TEST_DATABASE_URL=postgresql+psycopg://fahrrad:fahrrad@localhost:55432/fahrrad_test
# Gültigkeit der Posten-Tokens nach dem Laufdatum in Stunden
FP_TOKEN_GUELTIGKEIT_STUNDEN=24
# Aufbewahrungsfrist der Erfassungsdaten in Monaten
FP_AUFBEWAHRUNG_MONATE=12
# Sitzungs-Cookie nur über HTTPS (Produktion: true; lokal ohne HTTPS: false)
FP_COOKIE_SECURE=true
# Abmeldung nach Leerlauf (Minuten) bzw. spätestens nach (Stunden)
FP_SITZUNG_LEERLAUF_MINUTEN=120
FP_SITZUNG_MAX_STUNDEN=12
# Fehlversuche bei der Anmeldung je E-Mail bzw. IP in 15 Minuten
FP_ANMELDUNG_MAX_FEHLVERSUCHE=10
# Öffentliche Adresse (ohne Schrägstrich am Ende) – steht in den QR-Codes der Posten-Blätter
FP_OEFFENTLICHE_URL=https://fahrrad.example.org
# Zeitzone, in der ein Laufdatum endet
FP_ZEITZONE=Europe/Berlin

# Kartenkacheln für den Kartenausschnitt auf dem Posten-Blatt; leer = ohne Karte.
# Der Server lädt die Kacheln selbst (ausgehender HTTPS-Zugriff nötig).
FP_KARTEN_KACHELN=https://tile.openstreetmap.de/{z}/{x}/{y}.png

# Optional: Verzeichnis mit eigenen Feedbackbogen-Vorlagen und Logos je Schule (siehe README).
# Unter Docker Compose fest auf /vorlagen (= Ordner ./vorlagen neben docker-compose.yml).
FP_VORLAGEN_VERZEICHNIS=
